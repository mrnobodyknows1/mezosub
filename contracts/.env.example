# Copy to contracts/.env (gitignored). Used only by script/Deploy.s.sol.
DEPLOYER_PRIVATE_KEY=
# Optional: worker keeper wallet to receive KEEPER_ROLE.
KEEPER_ADDRESS=
# Optional (seconds), default 300.
MIN_INTERVAL=300
# Optional, default Mezo testnet MUSD.
MUSD_ADDRESS=0x118917a40FAF1CD7a13dB0Ef56C86De7973Ac503
# Local anvil only (chainid 31337): deploy a MockMUSD instead of using MUSD_ADDRESS.
# DEPLOY_MOCK_MUSD=true
