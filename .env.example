# ---------------------------------------------------------------- chain (web + worker)
NEXT_PUBLIC_MEZO_RPC_URL=https://rpc.test.mezo.org
NEXT_PUBLIC_MUSD_ADDRESS=0x118917a40FAF1CD7a13dB0Ef56C86De7973Ac503
# From contracts/deployments/31611.json after `forge script Deploy`
NEXT_PUBLIC_MANAGER_ADDRESS=
NEXT_PUBLIC_REGISTRY_ADDRESS=
NEXT_PUBLIC_DEPLOY_BLOCK=
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional: lists WalletConnect in the Mezo Passport connect modal (https://cloud.reown.com)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Demo billing: retry delays 120s,300s and a "demo" label in the UI
NEXT_PUBLIC_BILLING_DEMO_MODE=1
BILLING_DEMO_MODE=1

# ---------------------------------------------------------------- database (web + worker)
# Unset → embedded PGlite at .data/pglite (single process only: with PGlite, don't run `npm run worker` next to
# `next dev`; use POST /api/indexer/sync instead, or point both at a real Postgres).
# Optional: Postgres schema for MezoSub's tables when the database is shared (e.g. mezosub)
DATABASE_SCHEMA=
DATABASE_URL=

# ---------------------------------------------------------------- web only
# >= 32 random chars (openssl rand -hex 32). Required in production.
SESSION_SECRET=
# Bearer token for POST /api/indexer/sync (cron fallback). Empty = endpoint disabled.
INDEXER_SECRET=
# Optional: shown on /api/billing when the worker heartbeat hasn't reported the keeper yet
KEEPER_ADDRESS=

# ---------------------------------------------------------------- worker only (Render)
# NEVER set on the web deployment. Holds only gas + KEEPER_ROLE. Empty = keeper disabled (planning only).
KEEPER_PRIVATE_KEY=
RETRY_DELAYS_SECONDS=86400,172800
CONFIRMATIONS=2
WORKER_INTERVAL_MS=15000
# Optional tuning
# TX_TIMEOUT_SECONDS=180
# RECONCILE_EVERY=20
# PGLITE_DATA_DIR=.data/pglite

# ---------------------------------------------------------------- scripts/e2e-testnet.ts (never commit real keys)
MERCHANT_PRIVATE_KEY=
SUBSCRIBER_PRIVATE_KEY=
# E2E_API_URL=http://localhost:3000
